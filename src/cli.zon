.{
    .name = "sly",
    .description = "Shell AI command generator - convert natural language to shell commands",
    .options = .{
        .{
            .short = 't',
            .long = "timeout",
            .type = "?u32",
            .description = "Network timeout in seconds (default: 30)",
        },
    },
    .flags = .{
        .{
            .short = 'v',
            .long = "version",
            .description = "Show version information",
        },
    },
    .subcommands = .{
        .{
            .name = "shell",
            .description = "Shell integration management",
            .subcommands = .{
                .{
                    .name = "install",
                    .description = "Install shell integration plugin",
                    .options = .{
                        .{
                            .long = "shell",
                            .type = "?string",
                            .description = "Shell type (bash or zsh, auto-detects if omitted)",
                        },
                    },
                    .flags = .{
                        .{
                            .short = 'a',
                            .long = "auto",
                            .description = "Automatically add source line to shell rc file",
                        },
                    },
                },
            },
        },
        .{
            .name = "feedbytes",
            .description = "Process VT sequences and display terminal state (for testing)",
            .options = .{
                .{
                    .long = "input",
                    .type = "?string",
                    .description = "VT sequence input (reads from stdin if omitted)",
                },
            },
            .flags = .{
                .{
                    .short = 's',
                    .long = "snapshot",
                    .description = "Show snapshot hash and metadata",
                },
                .{
                    .short = 'r',
                    .long = "raw",
                    .description = "Show raw framebuffer cells with styling",
                },
            },
        },
        .{
            .name = "plan",
            .description = "Generate a CommandPlan JSON schema from natural language (for shell integration)",
            .options = .{
                .{
                    .long = "query",
                    .type = "string",
                    .description = "Natural language command query",
                },
                .{
                    .long = "context",
                    .type = "?string",
                    .description = "Recent terminal output to provide context for AI (optional)",
                },
            },
            .flags = .{
                .{
                    .short = 'p',
                    .long = "pretty",
                    .description = "Pretty-print the JSON output",
                },
            },
        },
    },
}
